# ─────────────────────────────────────────────────────────────────────────────
# TailorHub Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to backend/.env
#         cp backend/.env.example backend/.env
#   2. Fill in every value marked  ← REQUIRED
#   3. Optionally configure the services you want to enable
#   4. Never commit backend/.env  (it is in .gitignore)
#
# GENERATING SECRETS:
#   JWT_SECRET_KEY:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL Database ────────────────────────────────────────────────────────────
# The database must exist before starting the backend.
# CREATE DATABASE tailorhub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tailorhub
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here        # ← set this

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters for HS256 security.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_here_min_32_chars    # ← REQUIRED
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440                              # 24 hours; use 60 in production

# ── Seeded Admin Account ──────────────────────────────────────────────────────
# REQUIRED — created on first startup if the email doesn't exist.
# Password must be ≥12 chars with uppercase, lowercase, digit, and symbol.
DEFAULT_ADMIN_EMAIL=admin@tailorhub.pk               # ← change if needed
DEFAULT_ADMIN_PASSWORD=YourStr0ng!Password           # ← REQUIRED — change this
DEFAULT_ADMIN_NAME=Store Admin

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini API (Virtual Try-On feature) ──────────────────────────────────────
# Get an API key at: https://aistudio.google.com/apikey
# Leave empty to disable the Virtual Try-On feature.
GEMINI_API_KEY=

# ── OpenRouter API (Nano Banana / Gemini 2.5 Flash Image for VTO) ────────────
# Get an API key at: https://openrouter.ai/settings/keys
# This is the primary VTO provider — higher quality than direct Gemini free tier.
# Leave empty to fall back to HuggingFace IDM-VTON.
OPENROUTER_API_KEY=

# ── HuggingFace Token (IDM-VTON model) ───────────────────────────────────────
# Get a token at: https://huggingface.co/settings/tokens  (read access is enough)
# Optional — without it, the VTO will use anonymous HuggingFace quota (rate-limited).
HUGGINGFACE_TOKEN=

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production.
# Webhook secret: https://dashboard.stripe.com/webhooks
#   Local testing: stripe listen --forward-to localhost:3001/api/payments/webhook
# Leave empty to use mock/COD payments only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── SMTP Email (OTP Verification) ────────────────────────────────────────────
# For Gmail:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Use that 16-character password as SMTP_PASSWORD
# Leave SMTP_USER and SMTP_PASSWORD empty to use console fallback (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                                           # your Gmail address
SMTP_PASSWORD=                                       # App Password (not your login password)
SMTP_FROM_EMAIL=noreply@tailorhub.pk
SMTP_USE_TLS=True

# ── CORS & Frontend URL ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8080
