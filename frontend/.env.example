# ─────────────────────────────────────────────────────────────────────────────
# TailorHub Frontend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env (project root, next to package.json)
#         cp .env.example .env
#   2. Fill in the values below
#   3. Never commit .env (it is in .gitignore)
#
# All variables exposed to the browser MUST start with VITE_
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# The URL where your FastAPI backend is running.
# Development default: http://localhost:3001
# Production:          https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3001
